# Copy this file to .env and fill in real values. .env is gitignored.
# The app runs locally with no secrets; everything below is for deployment.

# --- Backend / CORS -----------------------------------------------------------
# TWO independent variables. Do not put a regex in CORS_ORIGINS.
#
#   CORS_ORIGINS       comma-separated list of *exact* origins  (allow_origins)
#   CORS_ORIGIN_REGEX  a single regex                           (allow_origin_regex)
#
# Local dev only needs CORS_ORIGINS (the Vite dev server). In production set
# CORS_ORIGIN_REGEX to cover every Vercel preview + production URL, and leave
# CORS_ORIGINS unset unless you add a fixed custom domain.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# --- Frontend (Vite) ---------------------------------------------------------
# Base URL the browser uses to reach the backend API. Inlined at BUILD time.
# Blank locally (the Vite dev proxy forwards /api to :8000); the Railway
# backend URL in production (no trailing slash).
VITE_API_BASE_URL=
